:root {
    --fondo: #09070d;
    --panel: #15111d;
    --morado: #bc35ff;
    --morado-claro: #e2a4ff;
    --blanco: #ffffff;
    --gris: #bcb4c7;
    --borde: #382347;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: var(--fondo);
    color: var(--blanco);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.encabezado {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 7%;
    background: #100b17;
    border-bottom: 1px solid var(--borde);
    flex-wrap: wrap;
}

.logo {
    color: var(--blanco);
    font-size: 30px;
    font-weight: 900;
    letter-spacing: 3px;
    text-shadow: 0 0 15px var(--morado);
}

.logo-icono {
    color: var(--morado);
}

.logo small {
    display: block;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--morado-claro);
}

nav {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}

nav a {
    color: var(--gris);
    font-size: 14px;
    transition: color .2s;
}

nav a:hover,
.enlace:hover {
    color: var(--morado-claro);
}

.contenedor {
    width: min(1120px, 90%);
    min-height: 70vh;
    margin: auto;
    padding: 35px 0 60px;
}

.hero {
    min-height: 390px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 35px 0 55px;
}

.hero-texto {
    max-width: 600px;
}

.etiqueta {
    color: var(--morado-claro);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
}

h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.15;
}

h1 span,
h2 span {
    color: var(--morado);
}

.hero h2 {
    font-size: 24px;
}

p {
    color: var(--gris);
}

.hero-logo {
    min-width: 230px;
    min-height: 230px;
    border: 2px solid var(--morado);
    border-radius: 50%;
    box-shadow: 0 0 30px #a020f055, inset 0 0 25px #a020f033;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.hero-logo strong {
    font-size: 62px;
    letter-spacing: 8px;
    text-shadow: 0 0 20px var(--morado);
}

.hero-logo span {
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--morado-claro);
}

.onda,
.producto-icono {
    font-size: 42px;
    color: var(--morado);
    text-shadow: 0 0 15px var(--morado);
}

.seccion {
    padding: 25px 0;
}

.subtitulo {
    margin-top: -12px;
    margin-bottom: 30px;
}

.productos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 28px;
}

.tarjeta {
    background: var(--panel);
    border: 1px solid var(--borde);
    border-radius: 16px;
    padding: 25px;
    transition: transform .2s, border-color .2s;
}

.tarjeta:hover {
    transform: translateY(-4px);
    border-color: var(--morado);
}

.tarjeta h2,
.tarjeta h3 {
    margin-bottom: 8px;
}

.tarjeta p {
    min-height: 48px;
}

.producto-icono {
    text-align: center;
    padding: 12px;
    font-size: 55px;
}

.precio {
    display: block;
    color: var(--morado-claro);
    font-size: 22px;
    margin: 18px 0;
}

.boton {
    display: inline-block;
    border: 0;
    border-radius: 9px;
    padding: 12px 20px;
    background: var(--morado);
    color: #100719;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
    transition: transform .2s, box-shadow .2s;
}

.boton:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 20px #bc35ff66;
}

.boton-secundario {
    background: transparent;
    color: var(--morado-claro);
    border: 1px solid var(--morado);
    margin-top: 8px;
}

.tarjeta .boton {
    width: 100%;
}

.mensaje {
    padding: 12px 16px;
    border-radius: 8px;
    margin: 12px 0;
}

.success {
    background: #18341f;
    color: #b8ffc4;
}

.error {
    background: #421c2b;
    color: #ffc4d2;
}

.tabla-contenedor {
    width: 100%;
    overflow-x: auto;
    margin: 24px 0;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: var(--panel);
}

th,
td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid var(--borde);
    white-space: nowrap;
}

th {
    color: var(--morado-claro);
}

.cantidad {
    width: 75px;
    padding: 9px;
}

input,
select {
    width: 100%;
    padding: 12px;
    background: #0d0912;
    color: white;
    border: 1px solid var(--borde);
    border-radius: 8px;
}

input:focus,
select:focus {
    outline: 1px solid var(--morado);
}

.boton-eliminar {
    padding: 8px 10px;
    background: #421c2b;
    color: white;
    border: 1px solid #a34565;
    border-radius: 7px;
    cursor: pointer;
}

.oculto {
    display: none;
}

.nota,
.aviso {
    padding: 12px;
    border-left: 3px solid var(--morado);
    background: #191020;
    font-size: 13px;
}

.total {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin: 25px 0;
    padding: 20px;
    background: var(--panel);
    border-radius: 10px;
    font-size: 20px;
}

.total strong {
    color: var(--morado-claro);
}

.enlace {
    display: inline-block;
    margin-left: 16px;
    color: var(--gris);
}

.vacio,
.confirmacion,
.formulario-seccion {
    max-width: 650px;
    margin: 30px auto;
    padding: 28px;
    background: var(--panel);
    border: 1px solid var(--borde);
    border-radius: 16px;
}

.vacio {
    text-align: center;
}

.confirmacion {
    text-align: center;
}

.confirmacion-icono {
    display: grid;
    place-items: center;
    width: 65px;
    height: 65px;
    margin: 0 auto;
    border-radius: 50%;
    background: var(--morado);
    color: #100719;
    font-size: 35px;
    font-weight: bold;
}

.resumen {
    margin: 22px 0;
    padding: 18px;
    background: #0d0912;
    border-radius: 10px;
    text-align: left;
}

.resumen-fila {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 10px 0;
    color: var(--gris);
}

.resumen-fila strong {
    color: var(--blanco);
}

.resumen-total {
    border-top: 1px solid var(--borde);
    margin-top: 8px;
    padding-top: 16px;
    font-size: 19px;
}

.resumen-total strong {
    color: var(--morado-claro);
}

.formulario {
    display: grid;
    gap: 12px;
}

.formulario label {
    margin-top: 8px;
    font-weight: bold;
}

.formulario .boton {
    margin-top: 12px;
}

.estadisticas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 18px;
    margin: 25px 0;
}

.estadisticas .precio {
    overflow-wrap: anywhere;
}

footer {
    padding: 25px;
    text-align: center;
    background: #100b17;
    border-top: 1px solid var(--borde);
    font-size: 13px;
}

footer p {
    margin: 4px;
}

@media (max-width: 650px) {
    .encabezado {
        padding: 18px 5%;
    }

    nav {
        gap: 12px;
    }

    .hero {
        flex-direction: column;
        align-items: flex-start;
    }

    .hero-logo {
        align-self: center;
        min-width: 190px;
        min-height: 190px;
    }

    .hero-logo strong {
        font-size: 48px;
    }

    .total {
        font-size: 16px;
    }

    .enlace {
        margin: 16px 0 0;
    }
}